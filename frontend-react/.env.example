# Local development can use /api through the Vite proxy.
# Production should use your Render backend URL, for example:
# VITE_API_BASE_URL=https://eldercare-backend-40ad.onrender.com/api
VITE_API_BASE_URL=/api

# Keep true when the backend is on Render Free, so the UI can wait for cold starts.
VITE_ENABLE_BACKEND_WAKEUP=true
